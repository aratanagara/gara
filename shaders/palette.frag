// =====================================================
// palette
// =====================================================
vec3 pal(int i){
  if(i==0)  return vec3(0.00,0.90,0.73);
  if(i==1)  return vec3(0.70,0.74,0.74);
  if(i==2)  return vec3(0.90,0.58,0.49);
  if(i==3)  return vec3(0.88,0.31,0.29);
  if(i==4)  return vec3(0.16,0.67,0.57);
  if(i==5)  return vec3(0.27,0.82,0.70);
  if(i==6)  return vec3(0.47,0.79,0.67);
  if(i==7)  return vec3(0.07,0.80,0.72);
  if(i==8)  return vec3(0.65,0.42,0.49);
  if(i==9)  return vec3(0.82,0.68,0.18);
  if(i==10) return vec3(0.44,0.60,0.83);
  return           vec3(0.11,0.59,0.88);
}

vec3 palPick(float x){
  return pal(int(floor(fract(x)*12.0)));
}

// =====================================================
// cosineGradient 共有パレット (全 cosGrad 対応シェーダ + 全体 cosGrad で共通)
//   uCosPalette でパレット選択。時間回転は全体 cosGrad と同期 (getBeat()*0.04)。
//   主要5色相: 浅葱 → 群青 → サーモンピンク → ライム → シルバー (シルバー比率を多めに)。
// =====================================================
uniform int uCosPalette;
vec3 cosGradColor(float t){
  t = fract(t + getBeat() * 0.04);
  if(uCosPalette == 1){   // Rainbow (classic)
    return vec3(0.55) + vec3(0.45) * cos(6.28318 * (t + vec3(0.0, 0.33, 0.67)));
  }
  // 0: 浅葱/群青/サーモンピンク/ライム + グレー系(シルバー多め + ライト/ふつう)
  vec3 stops[12] = vec3[12](
    vec3(0.16, 0.66, 0.69),   // 浅葱色
    vec3(0.20, 0.00, 0.82),   // 群青色 (#3f00ff を少し明度ダウン)
    vec3(1.00, 0.55, 0.48),   // サーモンピンク
    vec3(0.70, 0.93, 0.15),   // ライム
    vec3(0.80, 0.81, 0.83),   // シルバー
    vec3(0.70, 0.70, 0.70),   // ライトグレー
    vec3(0.80, 0.81, 0.83),   // シルバー
    vec3(0.45, 0.45, 0.45),   // ふつうのグレー
    vec3(0.80, 0.81, 0.83),   // シルバー
    vec3(0.70, 0.70, 0.70),   // ライトグレー
    vec3(0.45, 0.45, 0.45),   // ふつうのグレー
    vec3(0.70, 0.70, 0.70)    // ライトグレー
  );
  float u = t * 12.0;
  int i = int(floor(u));
  float f = smoothstep(0.0, 1.0, fract(u));
  vec3 col = mix(stops[i % 12], stops[(i + 1) % 12], f);
  // ディープグレーは細い一筋(窓幅0.022)だけ差し込む
  col = mix(col, vec3(0.22), smoothstep(0.022, 0.0, abs(t - 0.80)));
  return col;
}
